#!/usr/bin/env bash
# FACoP pre-receive gate (server-side, blocking).
#
# The position that actually matters in docs/security-model.md §2: history is rejected before it
# is accepted, so there is nothing to force-push away and no window in which a public
# append-only prompt log carries a live credential.
#
# Install on the forge (self-hosted GitHub Enterprise / GitLab / Gitea) as the repository's
# pre-receive hook. On github.com, where pre-receive hooks are unavailable, the equivalent
# positions are a push ruleset plus the required CI check — and push protection for the
# providers GitHub natively scans.
#
# Requires: node >= 24 and a checkout of this repository's scripts/ reachable at FACOP_SCRIPTS
# (defaults to the bare repository's own tree at the pushed revision).

set -euo pipefail

ZERO='0000000000000000000000000000000000000000'
status=0

while read -r _old new ref; do
  [ "$new" = "$ZERO" ] && continue   # branch deletion

  work="$(mktemp -d)"
  # Materialize only the pushed tree; never execute anything from it.
  git archive "$new" | tar -x -C "$work"

  scanner="${FACOP_SCRIPTS:-$work/scripts}/secret-scan.ts"
  if [ ! -f "$scanner" ]; then
    echo "pre-receive: secret scanner not found at $scanner; refusing to accept unverified history." >&2
    rm -rf "$work"; status=1; continue
  fi

  if ! (cd "$work" && node "$scanner"); then
    echo "" >&2
    echo "REJECTED $ref ($new): candidate secret in the pushed tree." >&2
    echo "Prompt logs are public and append-only once merged; rotate the credential and re-push." >&2
    status=1
  fi
  rm -rf "$work"
done

exit $status
