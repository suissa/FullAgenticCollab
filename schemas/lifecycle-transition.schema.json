{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://fullagenticcollab.dev/schemas/lifecycle-transition.schema.json",
  "title":"FACoP Lifecycle Transition","type":"object","additionalProperties":false,
  "required":["id","contribution_id","from","to","evidence"],
  "properties":{
    "id":{"type":"string","minLength":1},"contribution_id":{"type":"string","minLength":1},
    "from":{"type":"string","minLength":1},"to":{"type":"string","minLength":1},
    "evidence":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "actor":{"type":"string","minLength":1},"created_at":{"type":"string","format":"date-time"}
  }
}