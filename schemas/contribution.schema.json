{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullagenticcollab.dev/schemas/contribution.schema.json",
  "title": "FACoP v0.2 Validated Reason Contribution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "issue",
    "base_revision",
    "state",
    "claim",
    "reproduction",
    "reason_provenance",
    "attempts",
    "evidence"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "issue": { "type": "string", "minLength": 1 },
    "base_revision": { "type": "string", "minLength": 7 },
    "contribution_revision": { "type": ["string", "null"], "minLength": 7 },
    "generated_candidate_revision": { "type": ["string", "null"], "minLength": 7 },
    "state": {
      "enum": [
        "submitted",
        "claimed",
        "reproduction-submitted",
        "problem-proven",
        "reason-validated",
        "regenerating",
        "candidate-generated",
        "solution-proving",
        "solution-proven",
        "characterizing",
        "upstream-validating",
        "attested",
        "qualified",
        "proposed-for-merge",
        "under-review",
        "changes-requested",
        "accepted",
        "rejected",
        "withdrawn",
        "superseded"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_id", "statement"],
      "properties": {
        "semantic_id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["defect", "missing-behavior", "regression", "other"] }
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "inject_to", "command", "expected_failure"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "inject_to": { "type": "string", "minLength": 1 },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "expected_failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern"],
          "properties": {
            "exit_code": { "type": "integer", "minimum": 1 },
            "pattern": { "type": "string", "minLength": 1 },
            "semantic_id": { "type": ["string", "null"] }
          }
        },
        "digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "reason_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "context": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": { "$ref": "#/$defs/attempt" }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reviews": {
      "type": "array",
      "items": { "type": "string" }
    },
    "decision": { "type": ["string", "null"] }
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor_type", "result"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "actor_type": { "enum": ["human", "agent", "ci", "policy"] },
        "trust_plane": { "enum": ["contributor", "upstream", "qualification", "unknown"] },
        "model": { "type": ["string", "null"] },
        "prompt_digest": { "type": ["string", "null"] },
        "generation_recipe_digest": { "type": ["string", "null"] },
        "generated_candidate_digest": { "type": ["string", "null"] },
        "result": { "enum": ["accepted", "rejected", "superseded", "inconclusive"] }
      }
    }
  }
}
