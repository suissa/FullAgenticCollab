{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://fullagenticcollab.dev/schemas/candidate-generation.schema.json",
  "title":"FACoP Candidate Generation","type":"object","additionalProperties":false,
  "required":["candidate_revision","base_revision","generator","inputs","output_digest","trust_plane"],
  "properties":{
    "candidate_revision":{"type":"string","minLength":1},"base_revision":{"type":"string","minLength":1},
    "generator":{"type":"string","minLength":1},"inputs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "output_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"trust_plane":{"const":"upstream"}
  }
}